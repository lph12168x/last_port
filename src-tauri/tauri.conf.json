{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "last_port",
  "version": "0.1.0",
  "identifier": "dev-last-port-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "last_port",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "last_port",
    "category": "DeveloperTool",
    "shortDescription": "跨平台现代串口工具",
    "longDescription": "last_port 是一款轻量、跨平台的串口调试工具,基于 Tauri 2 + Rust + Svelte 5。提供串口枚举、可配置波特率/数据位/停止位/校验/流控、HEX/ASCII 双视图实时收发、按时间戳的接收日志、周期发送、日志导出等功能。打包仅 ~10MB,内存占用低,三端一致体验。",
    "copyright": "© 2025 last_port",
    "homepage": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}